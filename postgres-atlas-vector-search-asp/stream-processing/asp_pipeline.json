{
  "name": "pg_cdc_to_vector_search",
  "comment": "Consume AWS DMS CDC messages for demo_schema.knowledge_items from Amazon MSK, embed searchable text with Voyage AI over HTTPS, and materialize a delete-aware read model in Atlas. Replace <ATLAS_CONNECTION> and <KAFKA_CONNECTION> with your connection-registry names, and keep VOYAGE_MODEL / VOYAGE_DIMENSIONS in sync with .env and the Atlas Vector Search index definition.",
  "source": {
    "$source": {
      "connectionName": "<KAFKA_CONNECTION>",
      "topic": "cdc-knowledge-items",
      "tsFieldName": "cdc_ts"
    }
  },
  "pipeline": [
    {
      "$match": {
        "$and": [
          { "$or": [
            { "metadata.record-type": { "$exists": false } },
            { "metadata.record-type": "data" }
          ] },
          { "metadata.table-name": "knowledge_items" },
          { "metadata.operation": { "$in": ["load", "insert", "update", "delete"] } }
        ]
      }
    },
    {
      "$set": {
        "_is_delete": { "$eq": ["$metadata.operation", "delete"] },
        "source_updated_at": {
          "$cond": {
            "if": { "$gt": [{ "$toString": { "$ifNull": ["$data.updated_at", ""] } }, ""] },
            "then": { "$toDate": { "$toString": "$data.updated_at" } },
            "else": "$$NOW"
          }
        }
      }
    },
    {
      "$set": {
        "_id": {
          "$cond": {
            "if": { "$gt": [{ "$toString": { "$ifNull": ["$data.id", ""] } }, ""] },
            "then": { "$concat": ["knowledge-items-", { "$toString": "$data.id" }] },
            "else": "$$REMOVE"
          }
        }
      }
    },
    {
      "$match": {
        "_id": { "$ne": "$$REMOVE" }
      }
    },
    {
      "$set": {
        "searchable_text": {
          "$trim": {
            "input": {
              "$reduce": {
                "input": [
                  { "$ifNull": ["$data.title", ""] },
                  { "$ifNull": ["$data.body", ""] },
                  { "$ifNull": ["$data.tags", ""] },
                  { "$ifNull": ["$data.entity_type", ""] },
                  { "$ifNull": ["$data.department", ""] }
                ],
                "initialValue": "",
                "in": { "$concat": ["$$value", " ", "$$this"] }
              }
            }
          }
        }
      }
    },
    {
      "$https": {
        "connectionName": "<VOYAGE_HTTPS_CONNECTION>",
        "path": "embeddings",
        "method": "POST",
        "as": "voyage_response",
        "onError": "dlq",
        "config": {
          "connectionTimeoutSec": 30,
          "requestTimeoutSec": 60,
          "parseJsonStrings": true
        },
        "payload": [
          {
            "$project": {
              "_id": 0,
              "input": "$searchable_text",
              "model": "voyage-3.5",
              "input_type": "document",
              "output_dimension": 1024
            }
          }
        ]
      }
    },
    {
      "$set": {
        "embedding": { "$arrayElemAt": ["$voyage_response.data.embedding", 0] }
      }
    },
    {
      "$project": {
        "entity_type": { "$ifNull": ["$data.entity_type", ""] },
        "source_id": { "$toString": "$data.id" },
        "title": { "$ifNull": ["$data.title", ""] },
        "body": { "$ifNull": ["$data.body", ""] },
        "tags": { "$ifNull": ["$data.tags", ""] },
        "department": { "$ifNull": ["$data.department", ""] },
        "author": { "$ifNull": ["$data.author", ""] },
        "is_active": { "$ifNull": ["$data.is_active", false] },
        "searchable_text": 1,
        "embedding": 1,
        "source_updated_at": 1,
        "cdc_operation": "$metadata.operation",
        "cdc_ts": 1,
        "processed_at": "$$NOW"
      }
    },
    {
      "$merge": {
        "into": {
          "connectionName": "<ATLAS_CONNECTION>",
          "db": "enterprise_search_demo",
          "coll": "search_items"
        },
        "on": "_id",
        "whenMatched": {
          "$cond": {
            "if": "$_is_delete",
            "then": "delete",
            "else": "replace"
          }
        },
        "whenNotMatched": {
          "$cond": {
            "if": "$_is_delete",
            "then": "discard",
            "else": "insert"
          }
        },
        "parallelism": 1
      }
    }
  ]
}
