# ─────────────────────────────────────────────
# Atlas (existing cluster — reference only; see atlas-cluster-provisioning/)
# ─────────────────────────────────────────────
ATLAS_URI=mongodb+srv://<user>:<password>@<cluster-host>.mongodb.net
ATLAS_DATABASE=enterprise_search_demo
ATLAS_COLLECTION=search_items

# ─────────────────────────────────────────────
# Voyage AI (used by local scripts and the Streamlit app)
# NOTE: this local key is NOT used by Atlas Stream Processing.
# The ASP pipeline gets its Voyage key from the HTTPS connection
# registry entry you create in the Atlas UI. See README.
# ─────────────────────────────────────────────
VOYAGE_API_KEY=<your-voyage-api-key>
VOYAGE_MODEL=voyage-3.5
VOYAGE_DIMENSIONS=1024

# ─────────────────────────────────────────────
# PostgreSQL source (demo schema). Use the DMS/RDS endpoint
# from `terraform output` once the stack is applied.
# ─────────────────────────────────────────────
PG_HOST=<rds-endpoint>
PG_PORT=5432
PG_DATABASE=demodb
PG_USER=demo_dml
PG_PASSWORD=<choose-a-strong-password>
PG_SCHEMA=demo_schema
PG_TABLE=knowledge_items
