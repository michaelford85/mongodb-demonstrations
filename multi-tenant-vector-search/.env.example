# ─────────────────────────────────────────────
# Multi-Tenant Vector Search — environment
#
# Assumes a cluster already provisioned by ../atlas-cluster-provisioning
# with Search Nodes enabled. The scripts create everything else.
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# MongoDB Atlas connection
# Grab the SRV string from the atlas-cluster-provisioning Terraform output
# (connection_strings.standard_srv) and add your DB_ADMIN_USER / password.
# ─────────────────────────────────────────────
MONGODB_URI="mongodb+srv://username:password@your-cluster.mongodb.net/?retryWrites=true&w=majority"

# OR X.509 certificate auth — comment the line above and use both of these:
# MONGODB_URI="mongodb+srv://your-cluster.mongodb.net/?authSource=%24external&authMechanism=MONGODB-X509&retryWrites=true&w=majority"
# MONGODB_CERT="/path/to/your/cert.pem"

# ─────────────────────────────────────────────
# Namespace the demo loads into and searches
# ─────────────────────────────────────────────
DB_NAME=multi_tenant_vector_search
COLLECTION_NAME=documents

# ─────────────────────────────────────────────
# Index / View names — referenced by the setup scripts, the router, and the
# mongosh snippets in the README. Change here and everywhere stays in sync.
#   FLAT_INDEX  — the one shared flat index on the base collection (small tenants)
#   HNSW_INDEX  — the index name reused on each large-tenant view (default HNSW)
#   VIEW_PREFIX — large-tenant view names are VIEW_PREFIX + tenant_id
# ─────────────────────────────────────────────
FLAT_INDEX=shared_flat_index
HNSW_INDEX=tenant_hnsw_index
VIEW_PREFIX=tenant_view_

# ─────────────────────────────────────────────
# Voyage AI embeddings (client-side, so the same vectors index on the base
# collection AND the views). Skip the key entirely if you only ever use
# --fake-embeddings, which generates deterministic offline vectors.
# voyage-3.5 (recommended) | voyage-4 | voyage-4-lite
# ─────────────────────────────────────────────
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_MODEL=voyage-3.5
EMBEDDING_DIM=1024
BATCH_SIZE=128

# ─────────────────────────────────────────────
# Dataset profile — controls how many tenants and documents load_data creates.
#   demo  — small, real-embedding-friendly corpus (a few thousand docs)
#   scale — large corpus that crosses the ~10k-vectors-per-tenant regime line
#           (pair with --fake-embeddings to avoid a large embedding bill)
# ─────────────────────────────────────────────
PROFILE=demo

# ─────────────────────────────────────────────
# Query settings
# ─────────────────────────────────────────────
QUERY_LIMIT=10
