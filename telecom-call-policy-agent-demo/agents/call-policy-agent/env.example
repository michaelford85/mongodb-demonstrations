# Copy to .env before running. `.env` holds local secrets only.

# MongoDB connection string (existing Atlas cluster provisioned by
# ../atlas-cluster-provisioning, or any MongoDB you already run).
# Leave EMPTY for mock mode (in-memory store, nothing persisted) and for
# `agentengine dev` (the CLI provides a local MongoDB URI automatically).
MONGODB_URI=

# Demo database. Only collections defined in store.py are touched; the
# reset script drops ONLY these demo collections.
MONGODB_DATABASE=call_policy_demo

# Runtime database for Agent Engine checkpoints/traces (kept distinct from app data).
MDB_AGENTIC_STORE_DB=mdb_store_agent_call_policy_agent_local

# LLM credential read by src/agent_call_policy_agent/llm.py (Anthropic).
LLM_API_KEY=

# Not needed unless you enable features.memory in agent.yaml.
VOYAGE_API_KEY=
