# atlas-search-index-benchmark — copy to .env and fill in.
# NEVER commit .env. Placeholders only.

# REQUIRED for any live (non plan) phase: a NON-PRODUCTION Atlas cluster URI.
# This demo writes synthetic data and creates a Search index; do not point it
# at production. Approval by the cluster owner is required otherwise.
ATLAS_BENCHMARK_URI=

# Dedicated demo namespace. Do not point these at production or business data.
ATLAS_BENCHMARK_DB=search_bench_demo
ATLAS_BENCHMARK_COLLECTION=bench_docs

# Double gates: both must be true/yes before ANY write, index creation,
# load generation, or cleanup runs.
ALLOW_ATLAS_BENCHMARK_WRITES=false
BENCHMARK_CONFIRM=no

# Metadata you enter manually (never inferred from the URI).
CLUSTER_LABEL=enter-cluster-label-here
SEARCH_NODE_TIER=not-configured
SEARCH_NODE_TOPOLOGY=not-configured
# Operator-entered, verify in Atlas: region names and Search Node count.
ATLAS_BENCHMARK_REGIONS=
SEARCH_NODE_COUNT=not-configured

# Sustained validation window before the index phase reports ready.
INDEX_VALIDATION_WINDOW_SECONDS=30

# Workload knobs (see README). All are capped by hard safety ceilings.
DOC_COUNT=50000
GENERATOR_SEED=42
