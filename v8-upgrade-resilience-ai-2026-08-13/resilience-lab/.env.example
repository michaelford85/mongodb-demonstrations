# ─────────────────────────────────────────────────────────────────────────────
# Resilience Lab — environment
#
# Assumes a cluster already provisioned by ../../atlas-cluster-provisioning.
# Nothing here provisions, scales, or fails over a cluster; you drive those
# actions from the Atlas UI or CLI and watch the service react.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Connection ──────────────────────────────────────────────────────────────
# SRV string from the provisioning output (connection_strings.standard_srv).
# Leave retryWrites/w out of the URI — the options below set them, so a
# workshop can flip them without editing the URI.
MONGODB_URI="mongodb+srv://username:password@your-cluster.mongodb.net/"

# OR X.509 certificate auth — comment the line above and use both of these:
# MONGODB_URI="mongodb+srv://your-cluster.mongodb.net/?authSource=%24external&authMechanism=MONGODB-X509"
# MONGODB_CERT="/path/to/your/cert.pem"

DB_NAME=resilience_lab
ORDERS_COLLECTION=orders

# ─── Driver options — the levers for the experiments ─────────────────────────
# Set RETRY_WRITES=false to show what a step-down costs without retryable
# writes. RETRY_READS=false does the same for the read path.
RETRY_WRITES=true
RETRY_READS=true

# How long the driver hunts for a suitable server before giving up. Lower
# values surface errors faster during an election; higher values hide it.
SERVER_SELECTION_TIMEOUT_MS=5000
CONNECT_TIMEOUT_MS=5000
SOCKET_TIMEOUT_MS=10000

MAX_POOL_SIZE=20

# How often the driver polls each node. The default 10s means a step-down can
# take a moment to notice; 500ms makes recovery visibly faster.
HEARTBEAT_FREQUENCY_MS=10000

# Optional client-side operation timeout (CSOT). 0 leaves it unset.
# Setting this caps total time including retries — useful for showing a hard
# latency ceiling instead of an open-ended wait.
TIMEOUT_MS=0

WRITE_CONCERN=majority
READ_PREFERENCE=primary

# ─── Load generator ──────────────────────────────────────────────────────────
WORKER_COUNT=2
TARGET_OPS_PER_SECOND=10
READ_RATIO=0.5

# Start generating as soon as the service boots. Set false to drive it
# manually via POST /load/resume.
AUTOSTART=true

# ─── Metrics and service ─────────────────────────────────────────────────────
# Rolling window /status reports over. 30s reacts quickly; 120s is smoother
# for a longer scaling event.
METRICS_WINDOW_SECONDS=30
EVENT_LOG_SIZE=50

HOST=127.0.0.1
PORT=8000
