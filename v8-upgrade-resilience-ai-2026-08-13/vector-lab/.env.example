# Copy to .env and fill in. .env is gitignored; never commit real values.

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# The Atlas cluster from ../../atlas-cluster-provisioning. Atlas Search and
# Atlas Vector Search require an M10 or larger tier.
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority"

# OR X.509 certificate auth — comment the line above and use both of these:
# MONGODB_URI="mongodb+srv://your-cluster.mongodb.net/?authSource=%24external&authMechanism=MONGODB-X509"
# MONGODB_CERT="/path/to/your/cert.pem"

DB_NAME=vector_lab
COLLECTION_NAME=kb_articles

TEXT_INDEX=kb_text_index
VECTOR_INDEX=kb_vector_index

# ─── Embedding provider ──────────────────────────────────────────────────────
# offline : deterministic hash vectors. No key, no network, no cost. The
#           plumbing is real but semantic recall is meaningless — use it to
#           rehearse the lab mechanics, not to judge relevance.
# voyage  : real embeddings and real reranking.
# openai  : real embeddings; reranking falls back to the offline scorer.
EMBEDDING_PROVIDER=offline

# Required for voyage or openai. Leave blank for offline.
EMBEDDING_API_KEY=

# Model names and dimensionality must match what the vector index was built
# with — change these BEFORE running create_indexes, or rebuild the index.
#   voyage : voyage-3.5           (1024 dims, supports output_dimension)
#   openai : text-embedding-3-small (1536 dims, or 1024 via dimensions)
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIM=1024

# Voyage cross-encoder used by the "Vector + Rerank" mode.
RERANK_MODEL=rerank-2

EMBEDDING_BATCH_SIZE=64

# ─── Search behaviour ────────────────────────────────────────────────────────
# Results shown per search.
RESULT_LIMIT=8

# Candidates fetched by vector search before reranking. Must exceed
# RESULT_LIMIT or the reranker has nothing to reorder.
RERANK_CANDIDATES=40

# $vectorSearch numCandidates = limit * this. Higher trades latency for recall.
NUM_CANDIDATES_MULTIPLIER=15

SNIPPET_CHARS=220

# ─── Service ─────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8001

# Show the aggregation pipeline that produced the results, under each search.
SHOW_PIPELINE=true
