# ─────────────────────────────────────────────
# Version 8 Lab — environment
#
# Assumes a MongoDB 8.0+ cluster already provisioned by
# ../../atlas-cluster-provisioning. Nothing in this lab creates a cluster.
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# MongoDB Atlas connection
# Grab the SRV string from the atlas-cluster-provisioning Terraform output
# (connection_strings.standard_srv) and add your user / password.
# The user needs readWrite on the lab database and atlasAdmin (or equivalent)
# to run setQuerySettings / removeQuerySettings against the admin database.
# ─────────────────────────────────────────────
MONGODB_URI="mongodb+srv://username:password@your-cluster.mongodb.net/?retryWrites=true&w=majority"

# OR X.509 certificate auth — comment the line above and use both of these:
# MONGODB_URI="mongodb+srv://your-cluster.mongodb.net/?authSource=%24external&authMechanism=MONGODB-X509&retryWrites=true&w=majority"
# MONGODB_CERT="/path/to/your/cert.pem"

# ─────────────────────────────────────────────
# Namespace the lab seeds into and queries
# ─────────────────────────────────────────────
DB_NAME=version_8_lab
ORDERS_COLLECTION=orders
CUSTOMERS_COLLECTION=customers
