# Copy to .env and fill in. .env is gitignored; never commit real values.

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# The Atlas cluster from ../../atlas-cluster-provisioning.
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority"

# OR X.509 certificate auth — comment the line above and use both of these:
# MONGODB_URI="mongodb+srv://your-cluster.mongodb.net/?authSource=%24external&authMechanism=MONGODB-X509"
# MONGODB_CERT="/path/to/your/cert.pem"

DB_NAME=agent_lab
TICKETS_COLLECTION=tickets

# ─── LLM provider ─────────────────────────────────────────────────────────────
# offline   : a deterministic rule-based planner. No key, no network, no cost.
#             The agent loop, tool calls, and memory are real — only the
#             language model is replaced. Start here.
# openai    : chat completions.
# anthropic : messages API.
LLM_PROVIDER=offline

# Required for openai or anthropic. Leave blank for offline.
LLM_API_KEY=

# Match the model to the provider:
#   openai    : gpt-4o-mini, gpt-4o, ...
#   anthropic : claude-sonnet-4-5, claude-haiku-4-5, ...
LLM_MODEL=gpt-4o-mini

# 0.0 keeps tool selection reproducible, which matters when demoing live.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=700

# Optional: route through a gateway or self-hosted OpenAI-compatible endpoint.
# LLM_BASE_URL="https://your-gateway.example/v1"

# ─── Embedding provider (optional) ────────────────────────────────────────────
# Only used when USE_VECTOR_SEARCH=true. With it off, search_tickets does a
# regex scan instead, which is plenty at this data volume.
# offline | voyage | openai
EMBEDDING_PROVIDER=offline
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIM=256
EMBEDDING_BATCH_SIZE=64

# Requires embeddings in the documents AND an Atlas vector index (M10+).
# Seed with --embed, then create the index, before turning this on.
USE_VECTOR_SEARCH=false
VECTOR_INDEX=tickets_vector_index

# ─── Agent behaviour ──────────────────────────────────────────────────────────
# Tool calls allowed per user turn before the agent must answer. Bounds a
# mis-planned loop and keeps it visible in the trace.
MAX_STEPS=4

# Conversation turns kept as short-term memory.
MEMORY_TURNS=8

# Default row count for tools that take a limit.
DEFAULT_LIMIT=5

# Print the plan / tool call / observation trace. Leave on for a workshop —
# the trace is the thing being taught.
SHOW_TRACE=true
