# ─────────────────────────────────────────────
# Atlas on Azure — resilience and scalability test harness
#
# Copy to .env and fill in. .env is git-ignored; keep every value out of shell
# history and out of command-line arguments — all scripts read them from the
# environment only.
# ─────────────────────────────────────────────

# ── Test cluster connection ─────────────────
# SRV string for the non-production test cluster. Keep retryWrites=true so the
# failover tests measure driver-transparent recovery rather than client bugs.
#
# Use the readWriteAnyDatabase user here — DB_APP_USER in
# ../atlas-cluster-provisioning/.env. The load scripts need nothing more.
TEST_CLUSTER_URI=mongodb+srv://<user>:<password>@<host>/?retryWrites=true&w=majority

# Optional least-privilege split. Each falls back to TEST_CLUSTER_URI if unset.
#   MONITOR_CLUSTER_URI — baseline.py and watcher.py. clusterMonitor is enough
#                         (DB_MONITOR_USER); readWriteAnyDatabase is not, since
#                         it does not grant replSetGetStatus.
#   ADMIN_CLUSTER_URI   — shard_key_analysis.py only. configureQueryAnalyzer
#                         and analyzeShardKey require atlasAdmin (DB_ADMIN_USER).
MONITOR_CLUSTER_URI=
ADMIN_CLUSTER_URI=

# Database used by every script in this folder. Teardown drops it.
TEST_DB=resilience_test

# ── Atlas Administration API (read-only use here) ───
# Programmatic API key with Project Read Only for baseline/event collection.
# A key with Project Cluster Manager is required only to trigger Test Failover
# from the API instead of the Atlas UI.
ATLAS_PUBLIC_KEY=<public-key>
ATLAS_PRIVATE_KEY=<private-key>
ATLAS_PROJECT_ID=<project-id>
ATLAS_CLUSTER_NAME=<cluster-name>

# ── Harness tuning ──────────────────────────
# writer.py insert interval in seconds.
WRITER_INTERVAL=0.2

# load_harness.py: concurrent worker counts and target rate.
LOAD_WRITE_WORKERS=8
LOAD_READ_WORKERS=8
LOAD_TARGET_OPS_PER_SEC=400

# Where run artefacts are written (git-ignored).
RESULTS_DIR=results
