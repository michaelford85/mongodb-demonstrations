# ─────────────────────────────────────────────
# MongoDB Atlas connection (the ONLY cloud dependency)
# Reuse the SRV connection string from atlas-cluster-provisioning:
#   ../atlas-cluster-provisioning  →  terraform output  →  standard_srv
# Authenticate with the DB_ADMIN_USER / DB_ADMIN_PASSWORD you set there.
# Never commit the filled-in .env — it is gitignored.
# ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# ─────────────────────────────────────────────
# Source namespace in Atlas (self-seeded; no other namespace is touched)
# ─────────────────────────────────────────────
DB_NAME=atlas_iceberg_demo
COLLECTION_NAME=orders

# Historical rows written by `make seed` (deterministic, random.seed(42))
SEED_ORDER_COUNT=500

# ─────────────────────────────────────────────
# Local Iceberg infrastructure (all in Docker — no cloud services)
# These are non-secret local defaults; they are safe to keep as-is.
# ─────────────────────────────────────────────
ICEBERG_REST_URI=http://localhost:8181
ICEBERG_WAREHOUSE=s3://warehouse/
ICEBERG_NAMESPACE=demo
ICEBERG_TABLE=orders

# MinIO (local S3-compatible object storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=warehouse

# Trino (local SQL query engine)
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=demo
TRINO_CATALOG=iceberg
