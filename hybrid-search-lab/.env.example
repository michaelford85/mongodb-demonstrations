# ─────────────────────────────────────────────
# Hybrid Search Lab — environment
#
# Assumes a cluster already provisioned by ../atlas-cluster-provisioning
# with Compute Auto-Scale enabled (required for autoEmbed indexes).
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# MongoDB Atlas connection
# Grab the SRV string from the atlas-cluster-provisioning Terraform output
# (connection_strings.standard_srv) and add your DB_ADMIN_USER / password.
# ─────────────────────────────────────────────
MONGODB_URI="mongodb+srv://username:password@your-cluster.mongodb.net/?retryWrites=true&w=majority"

# OR X.509 certificate auth — comment the line above and use both of these:
# MONGODB_URI="mongodb+srv://your-cluster.mongodb.net/?authSource=%24external&authMechanism=MONGODB-X509&retryWrites=true&w=majority"
# MONGODB_CERT="/path/to/your/cert.pem"

# ─────────────────────────────────────────────
# Namespace the lab loads into and searches
# ─────────────────────────────────────────────
DB_NAME=hybrid_search_lab
COLLECTION_NAME=movies

# ─────────────────────────────────────────────
# Index names — referenced by the GUI, the setup scripts, and the
# mongosh snippets in the README. Change here and everywhere stays in sync.
# ─────────────────────────────────────────────
VECTOR_INDEX=movies_vector_index
TEXT_INDEX=movies_text_index

# ─────────────────────────────────────────────
# Automated Embedding (autoEmbed)
# The Voyage AI model Atlas uses to embed BOTH the indexed text field AND
# your query text — so no embeddings are generated client-side. Query text
# in the GUI and in mongosh is plain natural language.
# voyage-4-lite | voyage-4 (recommended) | voyage-4-large | voyage-code-3
# ─────────────────────────────────────────────
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIM=1024

# ─────────────────────────────────────────────
# App settings
# ─────────────────────────────────────────────
QUERY_LIMIT=10

# ─────────────────────────────────────────────
# Reranking (OPTIONAL — only the 🎯 Reranked tab uses these)
# The keyword, semantic, and hybrid tabs are 100% Atlas-native and need no
# API key. The rerank tab sends the hybrid candidates to a Voyage AI
# cross-encoder client-side. Get a key at https://www.voyageai.com
# ─────────────────────────────────────────────
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_RERANK_MODEL=voyage-rerank-2
