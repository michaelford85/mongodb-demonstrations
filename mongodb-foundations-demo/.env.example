# Connection string for an existing MongoDB deployment (replica set).
# The demo is run against the Atlas cluster from ../atlas-cluster-provisioning,
# but any replica-set deployment works. This is the only variable the CORE
# walkthrough (sections ①–⑦) reads.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority"

# ─────────────────────────────────────────────────────────────────────────────
# Search & RAG add-on (sections ⑧–⑨). All optional — leave unset to skip it.
# ─────────────────────────────────────────────────────────────────────────────

# Automated Embedding. The vector index is declared `autoEmbed`, so ATLAS
# embeds chunks and queries server-side — this app never computes a vector.
# Register the Voyage AI key in the Atlas project; these just name the model so
# the index definition and the README's mongosh snippets agree.
# EMBEDDING_MODEL="voyage-4"
# EMBEDDING_DIM="1024"

# Optional AI reranker (⑧ "AI retrieval" tab). A Voyage cross-encoder re-scores
# hybrid results client-side. Full-text, semantic, and hybrid search do NOT
# need this — only the rerank step does.
# VOYAGE_API_KEY="pa-..."
# VOYAGE_RERANK_MODEL="voyage-rerank-2"

# Optional RAG generation (⑨). MongoDB owns retrieval; generation is any LLM.
# Without a key the section still shows the grounding and the exact prompt.
# Any OpenAI-compatible endpoint works via GEN_BASE_URL.
# GEN_API_KEY="sk-..."
# GEN_MODEL="gpt-4o-mini"
# GEN_BASE_URL="https://api.openai.com/v1"

# Retrieval sizing (optional).
# QUERY_LIMIT="5"
# RAG_TOP_K="4"
