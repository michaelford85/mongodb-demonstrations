# ── MongoDB Atlas ──────────────────────────────────────────────────────────
# Standard Atlas connection string. Works with any Atlas replica set.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority"
MONGODB_DB_NAME="northstar_payments"

# ── Simulator settings (optional) ──────────────────────────────────────────
# Region used first when generating events; also the "home" region for storytelling.
SIMULATION_DEFAULT_REGION="us-east"
# How many events the simulator writes per tick in normal mode.
SIMULATION_BATCH_SIZE="4"

# ── Streamlit (optional) ───────────────────────────────────────────────────
STREAMLIT_SERVER_PORT="8501"
