# ── MongoDB Atlas (GEOSHARDED cluster REQUIRED) ────────────────────────────
# This demo runs against a real GEOSHARDED Atlas cluster with three zones, one
# per real region. Provision it first with ../atlas-sharded-cluster-provisioning
# using CLUSTER_TYPE=GEOSHARDED and CLUSTER_SHARDS in this exact order:
#   Zone 1 -> US_EAST_1   (region "us-east")
#   Zone 2 -> US_WEST_2   (region "us-west")
#   Zone 3 -> EU_WEST_1   (region "eu")
# The MONGODB_URI must point at that cluster's mongos routers (SRV string).
MONGODB_URI="mongodb+srv://<username>:<password>@<geosharded-host>/?retryWrites=true&w=majority"
MONGODB_DB_NAME="northstar_payments"

# ── Simulator settings (optional) ──────────────────────────────────────────
# Region used first when generating events; also the "home" region for storytelling.
# Must be one of the demo regions: us-east | us-west | eu
SIMULATION_DEFAULT_REGION="us-east"
# How many events the simulator writes per tick in normal mode.
SIMULATION_BATCH_SIZE="4"

# ── Streamlit (optional) ───────────────────────────────────────────────────
STREAMLIT_SERVER_PORT="8501"
