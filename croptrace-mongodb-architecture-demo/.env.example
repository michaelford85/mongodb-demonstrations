# ── MongoDB Atlas ──────────────────────────────────────────────────────────
# Standard Atlas connection string for the cluster provisioned by
# atlas-cluster-provisioning. Works with any Atlas replica set.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority"
MONGODB_DB_NAME="croptrace_demo"

# ── Embeddings (pluggable) ─────────────────────────────────────────────────
# Backend used for the Knowledge Assistant's vector search.
#   local  -> zero-dependency, deterministic embedder. Runs out of the box,
#             no API key required. This is the "no-keys" retrieval mode.
#   voyage -> Voyage AI embeddings. Requires `pip install voyageai` and a key.
EMBEDDING_PROVIDER="local"

# Vector dimensions. MUST match the vector search index (scripts/create_indexes.py).
#   local  -> 256 (default below)
#   voyage -> 1024 (set EMBEDDING_DIM=1024 when switching providers)
EMBEDDING_DIM="256"

# ── Voyage AI (server-side only; used when EMBEDDING_PROVIDER=voyage) ───────
# VOYAGE_API_KEY="your_voyage_api_key_here"
# VOYAGE_MODEL="voyage-3.5"

# ── Anthropic Claude (server-side only; optional grounded answers) ─────────
# Without a key the Knowledge Assistant still runs vector retrieval and shows
# a clearly-labelled extractive answer built only from retrieved snippets.
# ANTHROPIC_API_KEY="your_anthropic_api_key_here"
# Default is Anthropic's current lowest-cost model. Override as needed.
ANTHROPIC_MODEL="claude-haiku-4-5"

# ── Streamlit (optional) ───────────────────────────────────────────────────
STREAMLIT_SERVER_PORT="8501"
