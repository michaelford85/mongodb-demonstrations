# ─────────────────────────────────────────────
# MongoDB Atlas API Credentials
# Create a programmatic API key at:
#   Atlas UI → Access Manager → API Keys
# The key needs the "Organization Project Creator" role (minimum).
# ─────────────────────────────────────────────
ATLAS_PUBLIC_KEY=<your-public-api-key>
ATLAS_PRIVATE_KEY=<your-private-api-key>

# ─────────────────────────────────────────────
# Existing Atlas Project
# Found in Atlas UI → your project → Settings → Project ID
# ─────────────────────────────────────────────
ATLAS_PROJECT_ID=<your-existing-project-id>

# ─────────────────────────────────────────────
# Cluster Identity
# ─────────────────────────────────────────────
CLUSTER_NAME=demo-cluster

# ─────────────────────────────────────────────
# Cloud Provider
# Accepted values: AWS | GCP | AZURE
# All regions in CLUSTER_REGIONS must belong to this provider.
# ─────────────────────────────────────────────
CLUSTER_CLOUD_PROVIDER=AWS

# ─────────────────────────────────────────────
# Instance size — M10 is the smallest dedicated tier.
# Dedicated tiers required for multi-region and most Atlas features.
# Examples: M10, M20, M30, M40
#
# You may also name an NVMe tier directly (e.g. M40_NVME), which is
# equivalent to setting CLUSTER_STORAGE_CLASS=NVME below.
# ─────────────────────────────────────────────
CLUSTER_INSTANCE_SIZE=M30

# ─────────────────────────────────────────────
# Storage class
#   SSD  — network-attached SSD (the Atlas default). Disk size is
#          configurable and storage/compute auto-scaling is available.
#   NVME — local NVMe SSD. Terraform appends the _NVME suffix to
#          CLUSTER_INSTANCE_SIZE (e.g. M40 → M40_NVME).
#
# Local NVMe caveats:
#   - AWS only from M40 up; Azure only from M60 up. Not offered on GCP.
#   - Disk capacity is fixed per tier, so CLUSTER_DISK_SIZE_GB must be 0.
#   - Atlas does not auto-scale NVMe clusters, so the Compute Auto-Scale
#     block is skipped (which also rules out Atlas Automated Embedding).
#   - Cloud Backup is mandatory — CLUSTER_BACKUP_ENABLED is forced to true.
# ─────────────────────────────────────────────
CLUSTER_STORAGE_CLASS=SSD

# ─────────────────────────────────────────────
# Root volume capacity, in GB (SSD only).
# 0 = let Atlas apply the default size for the tier.
# Otherwise 10–4096. Azure requires one of its supported disk sizes
# (8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4095).
# Must be 0 when CLUSTER_STORAGE_CLASS=NVME.
# ─────────────────────────────────────────────
CLUSTER_DISK_SIZE_GB=0

# ─────────────────────────────────────────────
# Atlas Cloud Backup
# Adds snapshot storage cost, so it is off by default for demos.
# Forced to true when CLUSTER_STORAGE_CLASS=NVME — Atlas refuses to create
# a local NVMe cluster with Cloud Backup disabled.
# ─────────────────────────────────────────────
CLUSTER_BACKUP_ENABLED=false

# MongoDB major version
MONGODB_VERSION=8.0

# ─────────────────────────────────────────────
# Region topology
#
# CLUSTER_NUM_REGIONS — how many regions the cluster spans.
# Used for documentation and validated by deploy.sh against CLUSTER_REGIONS.
#
# CLUSTER_REGIONS — JSON array, one object per region.
#   region_name     : Atlas region identifier (see Atlas UI or docs)
#   electable_nodes : nodes in this region that can be elected primary
#   priority        : 7 = primary-eligible (highest), 6, 5 … for secondaries
#
# Total electable_nodes across ALL regions should be an odd number (3 or 5).
# Priority 7 must appear exactly once (the primary region).
#
# Single-region example (3-node replica set):
#   CLUSTER_REGIONS='[{"region_name":"US_EAST_1","electable_nodes":3,"priority":7}]'
#
# Three-region example (Milan primary, Mumbai + US East secondaries — 7 nodes total):
#   CLUSTER_REGIONS='[{"region_name":"EU_SOUTH_1","electable_nodes":3,"priority":7},{"region_name":"AP_SOUTH_1","electable_nodes":2,"priority":6},{"region_name":"US_EAST_1","electable_nodes":2,"priority":5}]'
# ─────────────────────────────────────────────
CLUSTER_NUM_REGIONS=1
CLUSTER_REGIONS='[{"region_name":"US_EAST_1","electable_nodes":3,"priority":7}]'

# ─────────────────────────────────────────────
# Atlas Search dedicated nodes
# 0 = Atlas Search runs on the electable nodes (shared, no extra cost).
# > 0 = dedicated Search nodes are provisioned (requires M10+).
# ─────────────────────────────────────────────
CLUSTER_SEARCH_NODES=0

# ─────────────────────────────────────────────
# Compute Auto-Scale
# Required by Atlas Automated Embedding (autoEmbed vector search indexes);
# Atlas refuses to create an autoEmbed index without it. Defaults to true.
#
# CLUSTER_COMPUTE_MAX_INSTANCE_SIZE: ceiling for scale-up. Leave blank to
# pin max = CLUSTER_INSTANCE_SIZE — that enables the feature without
# actually scaling, which is the cheapest configuration that still
# satisfies the autoEmbed prerequisite. Set it (e.g. M40) only if you
# want Atlas to scale up under load.
#
# Ignored when CLUSTER_STORAGE_CLASS=NVME — Atlas does not auto-scale
# local NVMe clusters.
# ─────────────────────────────────────────────
CLUSTER_COMPUTE_AUTOSCALE_ENABLED=true
CLUSTER_COMPUTE_MAX_INSTANCE_SIZE=

# ─────────────────────────────────────────────
# Admin database user
# This user is created with the atlasAdmin role.
# ─────────────────────────────────────────────
DB_ADMIN_USER=admin
DB_ADMIN_PASSWORD=<choose-a-strong-password>

# ─────────────────────────────────────────────
# Application database user
# This user is created with the readWriteAnyDatabase role — full read/write
# on every database, but no administrative privileges.
# ─────────────────────────────────────────────
DB_APP_USER=app-user
DB_APP_PASSWORD=<choose-a-strong-password>

# ─────────────────────────────────────────────
# Monitoring database user
# This user is created with the clusterMonitor role — read-only access to
# server status and diagnostic commands, no access to data.
# ─────────────────────────────────────────────
DB_MONITOR_USER=monitor-user
DB_MONITOR_PASSWORD=<choose-a-strong-password>
