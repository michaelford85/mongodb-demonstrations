# ── MongoDB Atlas ──────────────────────────────────────────────────────────
# Standard Atlas connection string for an existing cluster (for example the one
# from atlas-cluster-provisioning). This demo never creates Atlas resources.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority"
MONGODB_DB_NAME="product_catalog_studio"

# ── Embeddings (pluggable) ─────────────────────────────────────────────────
# Backend used for Semantic and Hybrid search modes.
#   local  -> zero-dependency, deterministic embedder. Runs out of the box,
#             no API key required. This is the "no-keys" mode.
#   voyage -> Voyage AI embeddings. Requires `pip install voyageai` and a key.
EMBEDDING_PROVIDER="local"

# Vector dimensions. MUST match the vector index (scripts/create_indexes.py)
# and the vectors written by seed_data.py.
#   local  -> 256 (default below)
#   voyage -> 1024 (set EMBEDDING_DIM=1024 when switching providers)
EMBEDDING_DIM="256"

# ── Voyage AI (server-side only; used when EMBEDDING_PROVIDER=voyage) ───────
# VOYAGE_API_KEY="your_voyage_api_key_here"
# VOYAGE_MODEL="voyage-3.5"
# Optional cross-encoder rerank of hybrid candidates. Only used when a key is
# set; the keyword, semantic, and hybrid modes work without it.
# VOYAGE_RERANK_MODEL="voyage-rerank-2"

# ── Anthropic Claude (server-side only; optional shortlist summary) ────────
# Without a key the search workspace still runs retrieval and shows a clearly
# labelled extractive summary built only from the retrieved product documents.
# ANTHROPIC_API_KEY="your_anthropic_api_key_here"
ANTHROPIC_MODEL="claude-haiku-4-5"

# ── Streamlit (optional) ───────────────────────────────────────────────────
STREAMLIT_SERVER_PORT="8501"
