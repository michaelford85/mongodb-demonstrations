# ─────────────────────────────────────────────
# Voyage AI Embedding Evaluation — environment
#
# Copy this file to .env (git-ignored) and fill in the placeholders:
#   cp .env.example .env
# Never commit .env, and never paste a real key into this example file.
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# MongoDB Atlas connection (distinct from any embedding API key)
# Needs: a user with readWrite on DB_NAME, your IP on the Atlas access list,
# and a tier that supports Atlas Vector Search. M0 allows only 3 search indexes
# in total — this demo creates 2 per run configuration (see README).
# ─────────────────────────────────────────────
MONGODB_URI="mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/?retryWrites=true&w=majority"

# Names used for everything this demo creates. Collections are named
# <COLLECTION_PREFIX>_<dataset>_<run-signature>_<voyage|competitor>.
DB_NAME=embedding_eval
COLLECTION_PREFIX=embeval

# ─────────────────────────────────────────────
# Voyage AI (the model under evaluation)
# Default: the Atlas-hosted Voyage endpoint, which accepts "model API keys"
# created in the Atlas UI (Atlas > AI Models). If you instead hold a key issued
# directly by Voyage AI, set VOYAGE_BASE_URL=https://api.voyageai.com/v1
# — the two key types are not interchangeable.
# ─────────────────────────────────────────────
VOYAGE_API_KEY=your_voyage_model_api_key_here
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
VOYAGE_MODEL=voyage-4
# Optional: a documented Voyage output dimension (256, 512, 1024, 2048).
# Leave blank to use the model default. Vectors are never truncated client-side.
VOYAGE_OUTPUT_DIMENSION=

# ─────────────────────────────────────────────
# Competitor (one provider + model of your choice).
# Defaults below: intfloat/multilingual-e5-large-instruct hosted on DeepInfra
# through its OpenAI-compatible endpoint (get a key at deepinfra.com).
# COMPETITOR_EMBEDDING_PROVIDER: openai | cohere | gemini
#   openai  -> POST {base}/embeddings. Also works with OpenAI-compatible servers
#              when you set COMPETITOR_BASE_URL (no document/query modes).
#   cohere  -> POST {base}/v2/embed   (input_type search_document / search_query)
#   gemini  -> POST {base}/models/<model>:batchEmbedContents
#              (taskType RETRIEVAL_DOCUMENT / RETRIEVAL_QUERY)
#   Hosted open-weights models: use openai + COMPETITOR_BASE_URL. Example, DeepInfra:
#     COMPETITOR_BASE_URL=https://api.deepinfra.com/v1/openai
#     COMPETITOR_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
# COMPETITOR_API_KEY is the generic key variable for whichever provider you pick.
# ─────────────────────────────────────────────
COMPETITOR_EMBEDDING_PROVIDER=openai
COMPETITOR_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
COMPETITOR_API_KEY=your_deepinfra_api_key_here
# Base URL override (required for DeepInfra / other OpenAI-compatible servers;
# leave blank to use the provider's own default endpoint).
COMPETITOR_BASE_URL=https://api.deepinfra.com/v1/openai
# Optional: provider-supported output dimension (openai `dimensions`,
# cohere `output_dimension`, gemini `outputDimensionality`). Blank = default.
COMPETITOR_OUTPUT_DIMENSION=
# Text prepended to every document / query before embedding. E5-instruct models
# need an instruction on QUERIES only (documents stay plain, per the model card).
# Write a newline as \n. Blank = no prefix (right for OpenAI, Cohere, Gemini).
# For SciFact-style claim queries, a closer task is:
#   "Instruct: Given a scientific claim, retrieve documents that support or refute the claim.\nQuery: "
COMPETITOR_DOCUMENT_PREFIX=
COMPETITOR_QUERY_PREFIX="Instruct: Given a question, retrieve relevant documents that best answer the question\nQuery: "

# ─────────────────────────────────────────────
# Evaluation defaults (all adjustable in the GUI)
# ─────────────────────────────────────────────
EVAL_DATASET=scifact
EVAL_NUM_QUERIES=50
EVAL_MAX_DOCS=1000
EVAL_SEED=42
# Comma-separated cutoffs. Retrieval depth is the largest value.
EVAL_K_VALUES=5,10

# Cache embeddings on disk (.cache/, git-ignored), keyed by provider + model +
# dimension + input mode + text hash. Set to false to always re-embed.
EVAL_USE_CACHE=true
