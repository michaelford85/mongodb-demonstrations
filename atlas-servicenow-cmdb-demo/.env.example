# ─────────────────────────────────────────────
# Atlas → ServiceNow CMDB sync demonstration
#
# Copy to .env and fill in. .env is git-ignored; keep every value out of
# shell history and out of command-line arguments — all scripts read them
# from the environment only. Mock mode (the default) needs NO credentials.
# ─────────────────────────────────────────────

# ── Demo behaviour ───────────────────────────
# mock  : use bundled synthetic fixtures, no Atlas credentials needed
# atlas : read-only live discovery against the Atlas Administration API
DEMO_SOURCE=mock

# CI class / attribute mapping file (see mapping.json)
DEMO_MAPPING_FILE=mapping.json

# ── Atlas (only needed for DEMO_SOURCE=atlas) ─
ATLAS_ORG_ID=<24-hex org id>

# Recommended: service account (OAuth 2.0 client credentials).
# Least-privilege roles: Organization Member + All Projects Read Only.
ATLAS_AUTH=service_account
ATLAS_CLIENT_ID=<service-account-client-id>
ATLAS_CLIENT_SECRET=<service-account-secret>

# Legacy alternative: API key (HTTP Digest). Leave blank unless you must.
# ATLAS_AUTH=api_key
ATLAS_PUBLIC_KEY=<public-key>
ATLAS_PRIVATE_KEY=<private-key>

ATLAS_ITEMS_PER_PAGE=100
ATLAS_TIMEOUT_SECONDS=20
ATLAS_MAX_RETRIES=4

# ── ServiceNow (only needed for --validate / --apply) ──
# Instance base URL. Never hard-code a real instance here in shared files.
SERVICENOW_INSTANCE_URL=https://<instance>.service-now.com
# User with the itil (or asset) role. Consider a dedicated integration user.
SERVICENOW_USERNAME=<integration-user>
SERVICENOW_PASSWORD=<integration-user-password>

# Must match a choice value on the discovery_source field of cmdb_ci.
# Create a custom discovery source record (e.g. "Atlas") in the target
# instance first, or set this to an existing choice value.
SERVICENOW_DISCOVERY_SOURCE=atlas

SERVICENOW_TIMEOUT_SECONDS=20
SERVICENOW_MAX_RETRIES=3

# SAFETY: live writes require BOTH --apply on the command line AND this
# value set to true. Anything else keeps the demo read-only / dry-run.
SERVICENOW_ALLOW_WRITES=false
