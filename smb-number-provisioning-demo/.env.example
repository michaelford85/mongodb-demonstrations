# ── Database connection (placeholders ONLY — never commit real values) ─────
# Copy this file to .env and fill it from your approved local secret source.
# The connection string is never printed, logged, or displayed by the demo.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority"

# Dedicated demo database. The app ONLY reads/writes this database; the
# connection string's default database is never used.
DEMO_DATABASE="smb_number_demo"

# ── Streamlit (optional) ───────────────────────────────────────────────────
STREAMLIT_SERVER_PORT="8510"
