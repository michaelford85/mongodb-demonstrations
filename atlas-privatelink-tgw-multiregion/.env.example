# ─────────────────────────────────────────────
# atlas-privatelink-tgw-multiregion
#
# Copy to .env and edit. .env is git-ignored.
#
# This file must never contain an Atlas connection string, an Atlas SRV URI,
# an Atlas API key, a database password or an AWS access key. None of them are
# needed: Terraform here only builds AWS networking, and the Atlas endpoint
# service names below are public identifiers, not credentials.
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# AWS credentials
# Use a named profile or an SSO session - never paste keys into this file.
#   aws sso login --profile <your-profile>
# ─────────────────────────────────────────────
AWS_PROFILE=default

# ─────────────────────────────────────────────
# Naming
# Every resource is named "<NAME_PREFIX>-<role>-<region key>".
# 2-23 characters, lowercase letters, digits and hyphens.
# ─────────────────────────────────────────────
NAME_PREFIX=atlas-plink-tgw

# ─────────────────────────────────────────────
# Mandatory tags
# Applied to every resource through the providers' default_tags, together with
# ManagedBy=Terraform. TAG_OWNER has no default: name whoever is accountable
# for deleting this lab.
# ─────────────────────────────────────────────
TAG_PROJECT=mongodb-demonstrations
TAG_ENVIRONMENT=lab
TAG_OWNER=<your-name-or-team>
TAG_PURPOSE=atlas-privatelink-tgw-multiregion-demo

# Optional extra tags as a JSON object. Cannot override the mandatory five.
# EXTRA_TAGS='{"CostCentre":"demo","TicketRef":"none"}'
EXTRA_TAGS='{}'

# ─────────────────────────────────────────────
# Hubs - one entry per AWS region the Atlas replica set has nodes in.
#
# Keys must be "a" and "b" (and optionally "c" - see README.md, "Adding a
# third region"). Region "a" is also where the client VPC and test VM go.
#
#   aws_region              AWS region name.
#   vpc_cidr_block          Hub VPC CIDR. /16 to /28. Must not overlap the
#                           client VPC or any other hub - Terraform checks.
#   subnet_cidrs            One subnet per AZ for the endpoint ENIs. Two or
#                           more is the supported shape; each ENI is billed
#                           hourly, and a single-AZ endpoint makes that AZ a
#                           single point of failure for the region.
#   availability_zones      Optional. Explicit AZ names, positionally matched
#                           to subnet_cidrs. Omit to take the first N AZs.
#   atlas_endpoint_services Map of label => the endpoint service name of the
#                           Atlas private endpoint that ALREADY EXISTS in that
#                           Atlas project and region. Read it from
#                           Atlas UI -> Network Access -> Private Endpoint, or
#                           from the Atlas Admin API. It looks like
#                           com.amazonaws.vpce.<region>.vpce-svc-<hex>.
#                           One Atlas project-region endpoint service serves
#                           every cluster in that project and region; it cannot
#                           serve a different Atlas project. Add a second label
#                           only for a second Atlas project in the same region.
#   amazon_side_asn         Optional Transit Gateway ASN. Defaults to
#                           64512 + position.
# ─────────────────────────────────────────────
HUBS='{
  "a": {
    "aws_region": "eu-west-1",
    "vpc_cidr_block": "10.20.0.0/16",
    "subnet_cidrs": ["10.20.1.0/24", "10.20.2.0/24"],
    "atlas_endpoint_services": {
      "primary": "com.amazonaws.vpce.eu-west-1.vpce-svc-0123456789abcdef0"
    }
  },
  "b": {
    "aws_region": "eu-central-1",
    "vpc_cidr_block": "10.30.0.0/16",
    "subnet_cidrs": ["10.30.1.0/24", "10.30.2.0/24"],
    "atlas_endpoint_services": {
      "primary": "com.amazonaws.vpce.eu-central-1.vpce-svc-abcdef01234567890"
    }
  }
}'

# ─────────────────────────────────────────────
# Client VPC and test VM. Lives in region key "a".
# The VM has no public IP, no key pair and no inbound rules: access is SSM
# Session Manager.
#
#   internet_egress_enabled  Creates an internet gateway, the NAT subnet below
#                            and a NAT gateway so the VM can install mongosh
#                            from repo.mongodb.org. This does NOT give the VM a
#                            path to Atlas: its security group only allows the
#                            MongoDB port range towards the hub VPC CIDRs, and
#                            only 80/443 towards the internet. Verify with
#                            `atlas-plink-egress-check` on the VM.
#                            Set CLIENT_INTERNET_EGRESS=false below and re-run
#                            ./deploy.sh once mongosh is installed: the NAT
#                            gateway, its elastic IP and the default route are
#                            removed and the VM keeps working.
#   nat_subnet_cidr          Small public subnet holding only the NAT gateway.
#                            Required while internet egress is on.
# ─────────────────────────────────────────────
CLIENT='{
  "region_key": "a",
  "vpc_cidr_block": "10.10.0.0/16",
  "subnet_cidrs": ["10.10.1.0/24", "10.10.2.0/24"],
  "nat_subnet_cidr": "10.10.255.0/28",
  "instance_type": "t3.micro"
}'

# ─────────────────────────────────────────────
# Internet egress toggle. Overrides internet_egress_enabled in CLIENT above, so
# you can flip it without editing JSON:
#   true  - NAT gateway exists, mongosh installs at boot
#   false - no NAT gateway, no elastic IP, no default route
# ─────────────────────────────────────────────
CLIENT_INTERNET_EGRESS=true

# ─────────────────────────────────────────────
# Application accounts (spokes) - OPTIONAL, default none.
#
# Each entry is a separate AWS account with its own VPC and test VM that
# consumes the SAME two interface endpoints this hub account owns. A spoke
# creates no interface endpoint and registers nothing with Atlas, so the number
# of PrivateLink endpoints stays at two however many accounts you onboard.
#
# Prerequisites:
#   - the accounts are in the same AWS Organization as this hub account, and
#     the management account has run once:
#       aws ram enable-sharing-with-aws-organization
#     (otherwise set RAM_ALLOW_EXTERNAL_PRINCIPALS=true and accept the share
#     manually in each account)
#   - Terraform can assume role_arn in each account. In an Organization the
#     default is OrganizationAccountAccessRole.
#   - every CIDR is unique across every account - Terraform checks.
#
# Keys must be "1" and "2". Spokes live in region A.
# ─────────────────────────────────────────────
SPOKES='{}'
# SPOKES='{
#   "1": {
#     "account_id": "111111111111",
#     "role_arn": "arn:aws:iam::111111111111:role/OrganizationAccountAccessRole",
#     "vpc_cidr_block": "10.40.0.0/16",
#     "subnet_cidrs": ["10.40.1.0/24", "10.40.2.0/24"],
#     "nat_subnet_cidr": "10.40.255.0/28"
#   },
#   "2": {
#     "account_id": "222222222222",
#     "role_arn": "arn:aws:iam::222222222222:role/OrganizationAccountAccessRole",
#     "vpc_cidr_block": "10.50.0.0/16",
#     "subnet_cidrs": ["10.50.1.0/24", "10.50.2.0/24"],
#     "nat_subnet_cidr": "10.50.255.0/28"
#   }
# }'

# Set true only if the spoke accounts are NOT in the same AWS Organization.
RAM_ALLOW_EXTERNAL_PRINCIPALS=false

# ─────────────────────────────────────────────
# Accept single-AZ interface endpoints.
# Leave false unless the region or the Atlas endpoint service genuinely offers
# only one AZ. See README.md, "Availability and cost trade-off".
# ─────────────────────────────────────────────
ALLOW_SINGLE_AZ_ENDPOINTS=false

# ─────────────────────────────────────────────
# Ports the on-instance TCP test probes on each endpoint ENI.
#
# Atlas allocates a BLOCK of ports per private endpoint starting at 1024, but
# which block depends on how many clusters and endpoints the Atlas project
# already has - a cluster can easily land on 1045 or higher. So the test scans
# a range rather than guessing individual ports, in parallel.
#
# The authoritative test needs none of this - it reads the real ports from the
# SRV record the driver uses:
#   atlas-plink-test --srv <cluster>-pl-0.xxxxx.mongodb.net
#
# TEST_PORT_SCAN  inclusive range to scan (max span 256).
# TEST_PORTS      extra individual ports on top of the range.
# ─────────────────────────────────────────────
TEST_PORT_SCAN='{"start": 1024, "end": 1060}'
TEST_PORTS='[27017]'

# ─────────────────────────────────────────────
# Optional: s3:// URI of a mongosh tarball you have staged in your own bucket.
# Tried before repo.mongodb.org, and the only way to install mongosh when
# CLIENT_INTERNET_EGRESS=false. Fetched over the S3 gateway endpoint; the
# instance role is scoped to exactly this object.
# ─────────────────────────────────────────────
MONGOSH_S3_URI=
