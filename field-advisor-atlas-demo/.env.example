# ── MongoDB Atlas ──────────────────────────────────────────────────────────
# Standard Atlas connection string. Works with any Atlas replica set.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority"
MONGODB_DB_NAME="field_advisor"

# ── Embeddings (pluggable) ─────────────────────────────────────────────────
# Which embedding backend to use for semantic/vector search.
#   local  -> zero-dependency, deterministic embedder. Runs out of the box,
#             no API key required. Great for a self-contained demo.
#   voyage -> Voyage AI embeddings for production-grade semantics.
#             Requires `pip install voyageai` and a VOYAGE_API_KEY.
EMBEDDING_PROVIDER="local"

# Vector dimensions. MUST match the vector search index (see scripts/create_indexes.py).
#   local  -> 256 (default below)
#   voyage -> 1024 (set EMBEDDING_DIM=1024 when switching providers)
EMBEDDING_DIM="256"

# ── Voyage AI (only used when EMBEDDING_PROVIDER=voyage) ────────────────────
# VOYAGE_API_KEY="your_voyage_api_key_here"
# VOYAGE_MODEL="voyage-3.5"

# ── Streamlit (optional) ───────────────────────────────────────────────────
STREAMLIT_SERVER_PORT="8501"
